/target
Cargo.lock.orig
*.swp
.DS_Store

# Node-local state (never commit keys or memory databases)
/data/
*.key
*.token
config.toml
__pycache__/
*.pyc
models/

# First-party plugin-release signing key: private half stays local,
# public half ships as keys/plugin-releases.pub
/keys/*
!/keys/README.md
!/keys/plugin-releases.pub

# Plugin bundle artifacts ship via releases, never the repo tree
/dist/
